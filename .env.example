# --- Configuración del bot de Discord ---
DISCORD_TOKEN=tu_token_del_bot_aqui
CLIENT_ID=id_de_tu_aplicacion_discord
GUILD_ID=id_de_tu_servidor_de_discord
VOICE_CHANNEL_ID=id_del_canal_de_voz

# --- Configuración del servidor de Minecraft ---
MC_HOST=ip_o_dominio_del_servidor_minecraft
MC_PORT=25565
# "java" o "bedrock"
MC_EDITION=java

# --- Configuración opcional ---
# Intervalo de verificación en milisegundos (30000 = 30 segundos)
CHECK_INTERVAL_MS=30000
